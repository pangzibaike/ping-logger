[Unit]
Description=Ping Logger HTTPS gateway
After=network-online.target ping-logger.service
Wants=network-online.target
[Service]
User=caddy
Group=caddy
ExecStart=/usr/bin/caddy run --config /etc/ping-logger/Caddyfile --adapter caddyfile
Environment=HOME=/var/lib/caddy
StateDirectory=caddy
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0027
[Install]
WantedBy=multi-user.target
